# Copy to .env.local and fill in. .env.local is gitignored -- never commit real keys.

# --- Supabase -------------------------------------------------------------
# Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret. Bypasses row-level security entirely, so it must stay server-side --
# never rename this to NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (image uploads) ---------------------------------------
# R2 -> Manage API tokens (Object Read & Write, scoped to the bucket).
# R2_ACCOUNT_ID takes the bare account ID or the "S3 API" endpoint URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=briar-chapel-images
# Public base URL the bucket is served from, no trailing slash.
R2_PUBLIC_URL=https://images.briarchapelconnect.com

# --- Resend (email) -------------------------------------------------------
# Resend -> API Keys. Sending access, restricted to briarchapelconnect.com.
# Sends support tickets and group proposals to the admin inbox; without it the
# support form fails and proposal emails are skipped.
RESEND_API_KEY=

# --- Clerk ----------------------------------------------------------------
# Clerk dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# These can stay as they are.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
