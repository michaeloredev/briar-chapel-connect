# Copy to .env.local and fill in. .env.local is gitignored -- never commit real keys.

# --- Supabase -------------------------------------------------------------
# Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret. Bypasses row-level security entirely, so it must stay server-side --
# never rename this to NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk ----------------------------------------------------------------
# Clerk dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# These can stay as they are.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
